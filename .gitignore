# ==============================================================================
# FinGraph Root .gitignore
# Covers: .NET 9, Node.js/Vite/TypeScript, Docker, IDEs, OS, and Local Configs
# ==============================================================================

# ------------------------------------------------------------------------------
# Build Artifacts & Output Directories (.NET & Node)
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
out/
dist/
build/
.vite/
*.user
*.userosscache
*.sln.docstates

# ------------------------------------------------------------------------------
# Node.js & Frontend Dependencies / Cache
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
.npm
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Local Environment & Secrets
# ------------------------------------------------------------------------------
# Exclude sensitive environment configurations and local overrides
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
appsettings.Local.json
appsettings.Development.json

# NOTE: Un-ignore specific template/example env files if needed
!scripts/config/environment.env.example
!.env.example

# ------------------------------------------------------------------------------
# Database & Docker Persistent Volume Mounts
# ------------------------------------------------------------------------------
# Local database files, SQLite DBs, and local volume dumps
*.db
*.sqlite
*.sqlite3
docker/postgres/data/
docker/redis/data/

# ------------------------------------------------------------------------------
# Test & Coverage Outputs
# ------------------------------------------------------------------------------
TestResults/
[Tt]est[Rr]esult*/
*.trx
coverage/
.coverage
*.coverage
*.coveragexml

# ------------------------------------------------------------------------------
# IDE & Code Editor Files
# ------------------------------------------------------------------------------
# Visual Studio
.vs/
*.suo
*.user
*.sln.docstates
*.userprefs
*.dtbcache
*.csproj.user

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider / ReSharper
.idea/
*_i4w/
*.DotSettings.user

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
.cache/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory